<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.taskmanager.controllers.MainController">
    <!-- Title Label -->
    <Label text="Task Manager" style="-fx-font-size: 24px;" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"/>

    <!-- Search Bar -->
    <TextField fx:id="searchField" promptText="Search Tasks..." AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"/>
    
    <!-- TableView for Tasks -->
    <TableView fx:id="taskTable" AnchorPane.topAnchor="120.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="100.0">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
            <TableColumn fx:id="dueDateColumn" text="Due Date" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Buttons (Add, Edit, Delete) -->
    <HBox spacing="10" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
        <Button text="Add Task" fx:id="addTaskButton" />
        <Button text="Edit Task" fx:id="editTaskButton"/>
        <Button text="Delete Task" fx:id="deleteTaskButton"/>
    </HBox>
</AnchorPane>
